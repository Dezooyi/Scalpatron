    "better-sqlite3": "^12.8.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.3.1",
    "technicalindicators": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
